FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY apps ./apps
COPY packages ./packages

RUN pip install --no-cache-dir ".[api]"

EXPOSE 8080

CMD ["uvicorn", "apps.agent_runtime.main:app", "--host", "0.0.0.0", "--port", "8080"]
