APP_ENV=local
LOG_LEVEL=INFO

# dev | oidc
AUTH_MODE=dev
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHM=RS256

# deterministic | openai | bedrock | litellm
MODEL_BACKEND=deterministic
MODEL_ALIAS=supplier-review

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=
LITELLM_MASTER_KEY=
LITELLM_BEDROCK_MODEL=

DATABASE_URL=postgresql+asyncpg://supplier:supplier@localhost:55432/supplier_assurance
DATABASE_SECRET_ARN=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=supplier_assurance
DATABASE_USER=
DATABASE_PASSWORD=
CHECKPOINT_BACKEND=memory
LANGGRAPH_DATABASE_URL=postgresql://supplier:supplier@localhost:55432/supplier_assurance
LANGGRAPH_STRICT_MSGPACK=true
POSTGRES_HOST_PORT=55432
REPOSITORY_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200
EMBEDDING_BACKEND=deterministic
EMBEDDING_DIMENSION=1024
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
RETRIEVAL_LIMIT=8

# local | step_functions
APPROVAL_WORKFLOW_BACKEND=local
STEP_FUNCTIONS_STATE_MACHINE_ARN=
MCP_HOST=0.0.0.0
MCP_PORT=8001

OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=20
OUTBOX_LOCK_TIMEOUT_SECONDS=120
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_SECONDS=2
OUTBOX_RETRY_MAX_SECONDS=300
